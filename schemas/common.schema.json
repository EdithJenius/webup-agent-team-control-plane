{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://webup.local/schemas/common",
  "$defs": {
    "record": {
      "type": "object",
      "required": ["schema_version", "kind", "id", "revision", "status", "owner_role", "created_at", "updated_at", "created_by", "updated_by"],
      "properties": {
        "schema_version": { "const": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "id": { "type": "string", "minLength": 1 },
        "project_id": { "type": "string", "minLength": 1 },
        "revision": { "type": "integer", "minimum": 1 },
        "status": { "type": "string", "minLength": 1 },
        "owner_role": { "type": "string", "minLength": 1 },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" },
        "created_by": { "type": "string", "minLength": 1 },
        "updated_by": { "type": "string", "minLength": 1 }
      }
    },
    "reference": {
      "type": "object",
      "required": ["ref", "revision"],
      "properties": {
        "ref": { "type": "string", "minLength": 1 },
        "revision": { "type": "integer", "minimum": 1 },
        "content_hash": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  }
}
