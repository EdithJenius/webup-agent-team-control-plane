{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://webup.local/schemas/artifact-index",
  "type": "object",
  "allOf": [
    { "$ref": "https://webup.local/schemas/common#/$defs/record" },
    {
      "type": "object",
      "required": ["project_id", "artifacts"],
      "properties": {
        "kind": { "const": "artifact-index" },
        "project_id": { "type": "string", "minLength": 1 },
        "artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["artifact_id", "artifact_type", "owner_role", "revision", "status", "location", "content_hash", "source_refs", "approval_refs", "usage_status"],
            "properties": {
              "artifact_id": { "type": "string", "minLength": 1 },
              "artifact_type": { "type": "string", "minLength": 1 },
              "owner_role": { "type": "string", "minLength": 1 },
              "revision": { "type": "integer", "minimum": 1 },
              "status": { "type": "string", "minLength": 1 },
              "location": { "type": "string", "minLength": 1 },
              "content_hash": { "type": "string", "minLength": 1 },
              "source_refs": { "type": "array", "items": { "type": "string" } },
              "approval_refs": { "type": "array", "items": { "type": "string" } },
              "contains_production_materials": { "type": "boolean" },
              "usage_status": { "enum": ["internal_analysis", "client_claimed", "license_verified", "production_approved", "prohibited"] }
            },
            "allOf": [
              {
                "if": { "properties": { "status": { "const": "production-candidate" } }, "required": ["status"] },
                "then": {
                  "properties": { "contains_production_materials": { "type": "boolean" } },
                  "required": ["contains_production_materials"]
                }
              },
              {
                "if": {
                  "properties": {
                    "status": { "const": "production-candidate" },
                    "contains_production_materials": { "const": true }
                  },
                  "required": ["status", "contains_production_materials"]
                },
                "then": {
                  "properties": {
                    "source_refs": { "type": "array", "minItems": 1 },
                    "approval_refs": { "type": "array", "minItems": 1 }
                  }
                }
              }
            ],
            "additionalProperties": false
          }
        }
      }
    }
  ],
  "unevaluatedProperties": false
}
