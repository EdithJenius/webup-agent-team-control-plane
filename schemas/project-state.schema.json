{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://webup.local/schemas/project-state",
  "type": "object",
  "allOf": [
    { "$ref": "https://webup.local/schemas/common#/$defs/record" },
    {
      "type": "object",
      "required": ["project_id", "current_stage", "permission_level", "project_control_lease_ref", "next_allowed_actions"],
      "properties": {
        "kind": { "const": "project-state" },
        "project_id": { "type": "string", "minLength": 1 },
        "current_stage": { "enum": ["P0", "P1", "P2", "P3", "P4", "P5", "P6", "P7", "P8", "P9"] },
        "permission_level": { "enum": ["A", "B", "C"] },
        "project_control_lease_ref": { "type": ["string", "null"], "minLength": 1 },
        "next_allowed_actions": { "type": "array", "items": { "type": "string" } },
        "release_candidate_ref": { "type": "string", "minLength": 1 },
        "rollback_ref": { "type": "string", "minLength": 1 },
        "quality_gates": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "result"],
            "properties": {
              "id": { "enum": ["build", "functionality", "conversion-path", "mobile", "accessibility", "performance", "security", "rollback"] },
              "result": { "enum": ["passed", "failed", "not_run"] },
              "evidence_ref": { "type": "string", "minLength": 1 },
              "evidence_revision": { "type": "integer", "minimum": 1 }
            },
            "if": { "properties": { "result": { "const": "passed" } }, "required": ["result"] },
            "then": {
              "properties": {
                "evidence_ref": { "type": "string", "minLength": 1 },
                "evidence_revision": { "type": "integer", "minimum": 1 }
              },
              "required": ["evidence_ref", "evidence_revision"]
            },
            "additionalProperties": false
          }
        }
      }
    }
  ],
  "unevaluatedProperties": false
}
